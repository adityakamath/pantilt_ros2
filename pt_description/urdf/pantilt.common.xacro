<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Color properties (RGBA) -->
  <xacro:property name="light_grey_rgba" value="0.8 0.8 0.8 1.0"/>
  <xacro:property name="charcoal_rgba" value="0.15 0.15 0.15 1.0"/>
  <xacro:property name="charcoal_rgb" value="0.15"/>

  <!-- Mesh variant: pt101 (default, recommended) or pt100; only the meshes differ, all origins and axes are shared -->
  <xacro:arg name="pantilt_config" default="pt101"/>
  <xacro:property name="pantilt_config" value="$(arg pantilt_config)"/>

  <!-- Pantilt base visual compensation / mount rotation (rad) -->
  <xacro:property name="pantilt_offset_rz" value="${pi/2}"/>

  <!-- Shoulder link visual compensation (rad) -->
  <xacro:property name="shoulder_offset_rx" value="${pi/2}"/>
  <xacro:property name="shoulder_offset_rz" value="${pi/2}"/>

  <xacro:property name="pantilt_base_mesh" value="pantilt_base_100.stl"/>
  <xacro:property name="shoulder_pan_mesh" value="pan_joint_100.stl"/>
  <!-- Mesh-local origin correction for the body meshes only; pt100 reuses the shared rotations, pt101 needs its own -->
  <xacro:property name="pantilt_base_mesh_rpy" value="0 0 ${pantilt_offset_rz}"/>
  <xacro:property name="shoulder_pan_mesh_rpy" value="${shoulder_offset_rx} 0 ${shoulder_offset_rz}"/>
  <xacro:property name="pantilt_base_mesh_xyz" value="0 0 0"/>
  <xacro:property name="shoulder_pan_mesh_xyz" value="0 0 -0.0483559"/>
  <xacro:if value="${pantilt_config == 'pt101'}">
    <xacro:property name="pantilt_base_mesh" value="pantilt_base_101.stl"/>
    <xacro:property name="shoulder_pan_mesh" value="pan_joint_101.stl"/>
    <xacro:property name="pantilt_base_mesh_rpy" value="${pi/2} 0 ${pi/2}"/>
    <xacro:property name="shoulder_pan_mesh_rpy" value="${pi/2} 0 ${pi}"/>
    <xacro:property name="pantilt_base_mesh_xyz" value="0 0 0.0002"/>
    <xacro:property name="shoulder_pan_mesh_xyz" value="-0.0120 0 -0.0463059"/>
  </xacro:if>

  <!-- Shoulder-pan joint origin; z is offset from the SO100 value and compensated in the mesh and tilt offsets so no frame moves -->
  <xacro:property name="shoulder_pan_x" value="0.0452"/>
  <xacro:property name="shoulder_pan_z" value="0.0648559"/>

  <!-- Joint limits for the URDF <limit> elements (pantilt.joints.xacro has matching defaults for ros2_control) -->
  <xacro:property name="shoulder_pan_lower" value="-1.5708"/>
  <xacro:property name="shoulder_pan_upper" value="1.5708"/>
  <xacro:property name="tilt_joint_lower" value="-1.5708"/>
  <xacro:property name="tilt_joint_upper" value="1.5708"/>

  <!-- Tilt joint origin in shoulder_link; the z offset cancels the shoulder_pan_z compensation above -->
  <xacro:property name="tilt_joint_x" value="0.0306"/>
  <xacro:property name="tilt_joint_z" value="0.0541441"/>

  <!-- Tilt joint frame rotation (makes Z the tilt axis, +θ = forward) -->
  <xacro:property name="tilt_joint_rx" value="${-pi/2}"/>
  <xacro:property name="tilt_joint_ry" value="${pi/2}"/>

  <!-- Tilt link visual compensation — counter-rotate joint frame + place mesh at base origin -->
  <xacro:property name="tilt_offset_rx" value="${pi/2}"/>
  <xacro:property name="tilt_offset_ry" value="${-pi/2}"/>
  <xacro:property name="tilt_visual_x" value="${shoulder_pan_z + tilt_joint_z}"/>
  <xacro:property name="tilt_visual_y" value="${shoulder_pan_x + tilt_joint_x}"/>
  <xacro:property name="tilt_visual_z" value="-0.0002"/>

  <!-- OAK-D-S2 camera mount offset (in tilt_link frame) -->
  <xacro:property name="oak_pos_x" value="-0.0306"/>
  <xacro:property name="oak_pos_y" value="-0.012165"/>

  <!-- OAK-D-S2 camera mount orientation (in tilt_link frame) -->
  <xacro:property name="oak_roll" value="${-pi/2}"/>
  <xacro:property name="oak_yaw"  value="${-pi/2}"/>

  <!-- OAK-D-S2 IMU offset (relative to oak frame) -->
  <xacro:property name="oak_imu_x" value="-0.008"/>
  <xacro:property name="oak_imu_y" value="-0.037945"/>
  <xacro:property name="oak_imu_z" value="-0.00079"/>
  <xacro:property name="oak_imu_r" value="${pi}"/>
  <xacro:property name="oak_imu_p" value="${pi/2}"/>

</robot>
