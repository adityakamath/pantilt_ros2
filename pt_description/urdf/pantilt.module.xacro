<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:include filename="$(find pt_description)/urdf/pantilt.common.xacro"/>
  <xacro:include filename="$(find pt_description)/urdf/oakd_s2.module.xacro"/>

  <xacro:macro name="pantilt_module" params="parent *origin">

    <!-- Material definitions (referenced by links below) -->
    <material name="light_grey">
      <color rgba="${light_grey_rgba}"/>
    </material>
    <material name="charcoal">
      <color rgba="${charcoal_rgba}"/>
    </material>

    <!-- Mount pantilt_base_link to parent platform at specified origin -->
    <joint name="pantilt_mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="pantilt_base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- Pan-tilt base link (was "base_link" in standalone URDF) -->
    <link name="pantilt_base_link">
      <inertial>
        <mass value="1.0"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
      </inertial>
      <visual>
        <origin xyz="${pantilt_base_mesh_xyz}" rpy="${pantilt_base_mesh_rpy}"/>
        <geometry>
          <mesh filename="package://pt_description/meshes/${pantilt_base_mesh}"/>
        </geometry>
        <material name="light_grey"/>
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 ${pantilt_offset_rz}"/>
        <geometry>
          <mesh filename="package://pt_description/meshes/pan_motor.stl"/>
        </geometry>
        <material name="charcoal"/>
      </visual>
      <collision>
        <origin xyz="${pantilt_base_mesh_xyz}" rpy="${pantilt_base_mesh_rpy}"/>
        <geometry>
          <mesh filename="package://pt_description/meshes/${pantilt_base_mesh}"/>
        </geometry>
      </collision>
    </link>

    <!-- Shoulder link (was "pan_link") -->
    <link name="shoulder_link">
      <inertial>
        <mass value="0.119226"/>
        <origin xyz="-9.07886e-05 0.0590972 -0.0172669" rpy="0 0 0"/>
        <inertia ixx="5.94278e-05" ixy="0" ixz="0" iyy="5.89975e-05" iyz="0" izz="3.13712e-05"/>
      </inertial>
      <visual>
        <origin xyz="${shoulder_pan_mesh_xyz}" rpy="${shoulder_pan_mesh_rpy}"/>
        <geometry>
          <mesh filename="package://pt_description/meshes/${shoulder_pan_mesh}"/>
        </geometry>
        <material name="light_grey"/>
      </visual>
      <visual>
        <origin xyz="0 0 -0.0483559" rpy="${shoulder_offset_rx} 0 ${shoulder_offset_rz}"/>
        <geometry>
          <mesh filename="package://pt_description/meshes/tilt_motor.stl"/>
        </geometry>
        <material name="charcoal"/>
      </visual>
      <collision>
        <origin xyz="${shoulder_pan_mesh_xyz}" rpy="${shoulder_pan_mesh_rpy}"/>
        <geometry>
          <mesh filename="package://pt_description/meshes/${shoulder_pan_mesh}"/>
        </geometry>
      </collision>
    </link>

    <!-- Tilt link -->
    <link name="tilt_link">
      <inertial>
        <mass value="0.1"/>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
      </inertial>
      <visual>
        <origin xyz="${tilt_visual_x} ${tilt_visual_y} ${tilt_visual_z}" rpy="${tilt_offset_rx} ${tilt_offset_ry} 0"/>
        <geometry>
          <mesh filename="package://pt_description/meshes/tilt_joint_oakd_s2.stl"/>
        </geometry>
        <material name="light_grey"/>
      </visual>
      <collision>
        <origin xyz="${tilt_visual_x} ${tilt_visual_y} ${tilt_visual_z}" rpy="${tilt_offset_rx} ${tilt_offset_ry} 0"/>
        <geometry>
          <mesh filename="package://pt_description/meshes/tilt_joint_oakd_s2.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- real/mujoco: 1e6 avoids spurious limit trips on joystick jumps; gazebo enforces the real ceiling -->

    <!-- Shoulder-pan joint (revolute; was "pan_joint") -->
    <joint name="shoulder_pan_joint" type="revolute">
      <parent link="pantilt_base_link"/>
      <child link="shoulder_link"/>
      <origin xyz="${shoulder_pan_x} 0 ${shoulder_pan_z}" rpy="0 0 0"/>
      <axis xyz="0 0 1"/>
      <limit lower="${shoulder_pan_lower}" upper="${shoulder_pan_upper}" effort="${max_torque_nm}" velocity="${1e6 if '$(arg ros2_control_hardware_type)' in ('real', 'mujoco') else pantilt_max_velocity_rads}"/>
    </joint>

    <!-- Tilt joint (revolute) -->
    <joint name="tilt_joint" type="revolute">
      <parent link="shoulder_link"/>
      <child link="tilt_link"/>
      <origin xyz="${tilt_joint_x} 0 ${tilt_joint_z}" rpy="${tilt_joint_rx} ${tilt_joint_ry} 0"/>
      <axis xyz="0 0 -1"/>
      <limit lower="${tilt_joint_lower}" upper="${tilt_joint_upper}" effort="${max_torque_nm}" velocity="${1e6 if '$(arg ros2_control_hardware_type)' in ('real', 'mujoco') else pantilt_max_velocity_rads}"/>
    </joint>

    <!-- OAK-D-S2 Camera + IMU -->
    <xacro:oakd_s2_camera
      camera_name="oak_link"
      base_frame="oak_link"
      parent="tilt_link"
      cam_pos_x="${oak_pos_x}" cam_pos_y="${oak_pos_y}" cam_pos_z="0"
      cam_roll="${oak_roll}" cam_pitch="0" cam_yaw="${oak_yaw}"
      r="${charcoal_rgb}" g="${charcoal_rgb}" b="${charcoal_rgb}" a="1.0"
      imu_frame="oak_imu_frame"/>

  </xacro:macro>

</robot>
