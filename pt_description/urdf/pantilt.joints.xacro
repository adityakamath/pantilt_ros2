<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- pantilt_joints: ros2_control joints for a host's shared-bus block; defaults are the mechanism's calibration and the slow 65/50/0 servo profile -->
  <xacro:macro name="pantilt_joints" params="
      shoulder_pan_motor_id:=1
      tilt_motor_id:=2
      shoulder_pan_center_steps:=2048
      tilt_center_steps:=2048
      sts3215_max_vel_steps:=3400
      shoulder_pan_lower:=-1.5708
      shoulder_pan_upper:=1.5708
      tilt_joint_lower:=-1.5708
      tilt_joint_upper:=1.5708
      internal_max_vel:=65
      internal_max_acc:=50
      internal_acc_coeff:=0
      ros2_control_hardware_type:=real">

    <!-- 85% of hardware max — 15% safety margin; motor firmware handles profiling -->
    <xacro:property name="pantilt_max_velocity_steps" value="${int(sts3215_max_vel_steps * 0.85)}"/>
    <xacro:property name="pantilt_max_velocity_rads"  value="${pantilt_max_velocity_steps * 2 * pi / 4096}"/>

    <!-- Shoulder-pan axis: rotates the payload around Z -->
    <joint name="shoulder_pan_joint">
      <param name="motor_id">${shoulder_pan_motor_id}</param>
      <param name="operating_mode">0</param>
      <param name="min_position">${shoulder_pan_lower}</param>
      <param name="max_position">${shoulder_pan_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts3215_max_vel_steps}</param>
      <param name="max_velocity">${pantilt_max_velocity_rads}</param>
      <param name="position_center_steps">${shoulder_pan_center_steps}</param>
      <param name="internal_max_vel">${internal_max_vel}</param>
      <param name="internal_max_acc">${internal_max_acc}</param>
      <param name="internal_acc_coeff">${internal_acc_coeff}</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- Real hardware only: sim joints have no such telemetry -->
      <xacro:if value="${ros2_control_hardware_type == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

    <!-- Tilt axis: rotates the payload around Y -->
    <joint name="tilt_joint">
      <param name="motor_id">${tilt_motor_id}</param>
      <param name="operating_mode">0</param>
      <param name="min_position">${tilt_joint_lower}</param>
      <param name="max_position">${tilt_joint_upper}</param>
      <!-- Motor-specific, model-dependent parameter (per joint so different STS models can share this bus) -->
      <param name="max_velocity_steps">${sts3215_max_vel_steps}</param>
      <param name="max_velocity">${pantilt_max_velocity_rads}</param>
      <param name="position_center_steps">${tilt_center_steps}</param>
      <param name="internal_max_vel">${internal_max_vel}</param>
      <param name="internal_max_acc">${internal_max_acc}</param>
      <param name="internal_acc_coeff">${internal_acc_coeff}</param>
      <command_interface name="position"/>
      <state_interface name="position"/>
      <state_interface name="velocity"/>
      <state_interface name="effort"/>
      <!-- Real hardware only: sim joints have no such telemetry -->
      <xacro:if value="${ros2_control_hardware_type == 'real'}">
        <state_interface name="voltage"/>
        <state_interface name="temperature"/>
        <state_interface name="current"/>
        <state_interface name="is_moving"/>
      </xacro:if>
    </joint>

  </xacro:macro>

</robot>
