<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- Arguments (externally settable) -->
  <xacro:arg name="serial_port"            default="/dev/ttySERVO"/>
  <xacro:arg name="baud_rate"              default="1000000"/>
  <xacro:arg name="use_mock"               default="false"/>
  <xacro:arg name="use_sync_write"         default="true"/>
  <xacro:arg name="sts3215_max_vel_steps" default="3400"/>   <!-- STS3215=3400, STS3032=2900, STS3235=3400 -->
  <xacro:arg name="proportional_vel_max"   default="0"/>      <!-- [0-max_velocity_steps]; 0 = each joint uses commanded velocity -->
  <!-- Motor IDs, step-centering, and joint limits are NOT xacro:args here - they're
       physical-calibration constants for this mechanism (motor wiring, servo centering),
       not per-deployment connection settings, so pantilt.joints.xacro's macro defaults are
       their single source of truth (same convention as so101.control.xacro/so100.control.xacro
       in so_arm_ros2, which hardcode motor IDs/joint limits as fixed xacro:property values
       rather than sourcing them from an external launch-time YAML). A host embedding this
       mechanism on a shared bus (e.g. lekiwi_ros2's base_pantilt.control.xacro) can still
       override any of pantilt_joints' macro params explicitly if it ever needs different
       values - see pantilt.joints.xacro. -->

  <!-- Simulation -->
  <!-- "real" (default) keeps the STS3215 serial hardware plugin below unchanged.
       "gazebo" swaps the <hardware> plugin for gz_ros2_control/GazeboSimSystem.
       "mujoco" swaps it for mujoco_ros2_control/MujocoSystemInterface.
       Both implement the same SystemInterface contract - the joints and controllers stay
       identical in all three cases. -->
  <xacro:arg name="ros2_control_hardware_type" default="real"/>
  <!-- Path to the controllers YAML the embedded controller_manager should load; only
       used when the <gazebo> plugin below is actually instantiated (i.e. in sim). -->
  <xacro:arg name="simulation_controllers" default=""/>
  <!-- mujoco mode only: path to the MJCF generated by pt_mujoco's build_mujoco_models (see
       pt_control/launch/pantilt.launch.py; pantilt_config picks the pt100/pt101 variant) and
       whether to open the MuJoCo Simulate viewer window. -->
  <xacro:arg name="mujoco_model" default=""/>
  <xacro:arg name="mujoco_headless" default="false"/>

  <!-- Motor-specific, model-dependent velocity ceiling — defined before <ros2_control>
       because pantilt_joints (called below) writes it per joint as max_velocity_steps. -->
  <xacro:property name="sts3215_max_vel_steps" value="$(arg sts3215_max_vel_steps)"/>

  <!-- Torque limit as a top-level property — required by pantilt.module.xacro for the URDF
       <limit> elements on the revolute joints.
       pantilt_max_velocity_rads duplicates pantilt_joints' own local computation
       (pantilt.joints.xacro) - only used by module.xacro's gazebo-mode <limit velocity>,
       real mode keeps velocity="1e6" (see module.xacro's comment on why) regardless. -->
  <!-- This project runs the 12V STS3215 variant: 30 kgf*cm stall torque per Feetech's
       datasheet for that voltage option (not the 7.4V/19.5 kgf*cm variant used by stock
       SO-ARM100/101). -->
  <xacro:property name="max_torque_nm"    value="2.942"/>  <!-- N⋅m (30 kgf⋅cm @ 12V) -->
  <xacro:property name="pantilt_max_velocity_steps" value="${int(sts3215_max_vel_steps * 0.85)}"/>
  <xacro:property name="pantilt_max_velocity_rads"  value="${pantilt_max_velocity_steps * 2 * pi / 4096}"/>

  <xacro:include filename="$(find pt_description)/urdf/pantilt.joints.xacro"/>

  <!-- ROS 2 CONTROL -->
  <ros2_control name="pantilt_control" type="system">
    <hardware>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'gazebo'}">
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'mujoco'}">
        <plugin>mujoco_ros2_control/MujocoSystemInterface</plugin>
        <param name="mujoco_model">$(arg mujoco_model)</param>
        <param name="headless">$(arg mujoco_headless)</param>
      </xacro:if>
      <xacro:if value="${'$(arg ros2_control_hardware_type)' == 'real'}">
        <plugin>sts_hardware_interface/STSHardwareInterface</plugin>
        <param name="serial_port">$(arg serial_port)</param>
        <param name="baud_rate">$(arg baud_rate)</param>
        <param name="communication_timeout_ms">100</param>
        <param name="use_sync_write">$(arg use_sync_write)</param>
        <param name="enable_mock_mode">$(arg use_mock)</param>
        <param name="proportional_vel_max">$(arg proportional_vel_max)</param>
        <param name="reset_states_on_activate">true</param>
      </xacro:if>
    </hardware>

    <xacro:pantilt_joints
        sts3215_max_vel_steps="${sts3215_max_vel_steps}"
        ros2_control_hardware_type="$(arg ros2_control_hardware_type)"/>
  </ros2_control>

</robot>
