<!-- tilt_link and the Gemini 2 mount, spliced into shoulder_link by pantilt.mjcf.xacro; rotations are quats because URDF rpy order differs from MuJoCo euler -->
<mujoco>
  <body name="tilt_link" pos="0.0306 0 0.0541441" quat="0.5 -0.5 0.5 0.5">
    <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
    <joint name="tilt_joint" class="pt_sts3215" axis="0 0 -1" range="-1.5708 1.5708"/>
    <geom mesh="tilt_joint_gemini2" material="light_grey" class="visual"
          pos="0.119 0.0758 -0.000425" quat="0.5 0.5 -0.5 0.5"/>
    <geom mesh="tilt_joint_gemini2" class="collision"
          pos="0.119 0.0758 -0.000425" quat="0.5 0.5 -0.5 0.5"/>

    <!-- Gemini 2 camera mount - decorative mass, no collision geom. -->
    <body name="gemini2_link" pos="-0.0306 -0.0068941 -0.000225" quat="0.5 -0.5 0.5 -0.5">
      <body name="gemini2_link_model_origin" quat="0.5 0.5 0.5 0.5">
        <geom mesh="gemini2" class="visual" rgba="0.15 0.15 0.15 1.0" quat="0 0 0 1"/>
      </body>
      <!-- Gemini 2 16:9 RGB profile, nominal V55/H86; depth is rendered registered to color. -->
      <camera name="gemini2_rgb" fovy="55" resolution="640 360" pos="0 0 0" quat="1 0 0 0"/>
      <!-- Ideal co-located six-axis IMU, optical axes; device extrinsics need calibration. -->
      <site name="gemini2_imu" pos="0 0 0" quat="0.5 -0.5 0.5 -0.5" size="0.001"/>

    </body>
  </body>
</mujoco>
