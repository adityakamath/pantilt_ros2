<?xml version="1.0"?>
<!-- STS3215 joint defaults for pan/tilt; class is pt_sts3215 because default class names are global and lekiwi_mujoco has sts3215 -->
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">
  <default class="pt_sts3215">
    <!-- BAM-identified from a real STS3215 (12V), model m1 (github.com/Rhoban/bam), with error_gain_ratio folded in -->
    <!-- Stiff end stops: a soft limit lets a full-speed jump pass the URDF limit and deactivates the controller -->
    <joint damping="1.057835" frictionloss="0.195871" armature="0.032460"
           solreflimit="0.004 1" solimplimit="0.99 0.999 0.001 0.5 2"/>
    <position kp="42.911886" kv="0.0" forcerange="-8.537717 8.537717"/>
    <!-- so_arm_mujoco's copy also nests visual/collision geom sub-classes for its own STS3215
         motor meshes; omitted here since pantilt_shared.xml defines its own same-named ones. -->
  </default>
</mujoco>
