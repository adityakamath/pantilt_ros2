<!--
  tilt_link and its OAK-D S2 mount, as an includable fragment spliced inside shoulder_link's
  <body> by pantilt.mjcf.xacro. Fully shared between pt100/pt101 (only pantilt_base_link's
  and shoulder_link's own meshes differ - see pantilt.common.xacro).

  oak_link/oak_link_model_origin are welded (no <joint>) rigid sub-bodies, mirroring the two
  nested fixed joints oakd_s2.module.xacro's URDF macro creates.

  Every rotation below has 2+ nonzero rpy axes in the source URDF, so each is given as a quat
  computed directly from the URDF's rpy (URDF composes rpy as Rz*Ry*Rx; MuJoCo's default
  euler="xyz" composes as Rx*Ry*Rz - the reverse order, they only agree with a single nonzero
  axis) - see pantilt.mjcf.xacro's matching comment.
-->
<mujoco>
  <body name="tilt_link" pos="0.0306 0 0.1025" quat="0.5 -0.5 0.5 0.5">
    <inertial pos="0 0 0" mass="0.1" diaginertia="0.001 0.001 0.001"/>
    <joint name="tilt_joint" class="tilt"/>
    <geom mesh="tilt_joint_oakd_s2" material="light_grey" class="visual"
          pos="0.119 0.0758 -0.0002" quat="0.5 0.5 -0.5 0.5"/>
    <geom mesh="tilt_joint_oakd_s2" class="collision"
          pos="0.119 0.0758 -0.0002" quat="0.5 0.5 -0.5 0.5"/>

    <!-- OAK-D S2 camera mount - decorative mass, no collision geom. -->
    <body name="oak_link" pos="-0.0306 -0.012165 0" quat="0.5 -0.5 0.5 -0.5">
      <body name="oak_link_model_origin" quat="0.5 0.5 0.5 0.5">
        <geom mesh="oakd_s2" class="visual" rgba="0.15 0.15 0.15 1.0"/>
      </body>
      <!-- RGB camera (mujoco_ros2_control_plugins/CameraPlugin). fovy=55 matches the real
           OAK-D S2's VFOV; resolution matches oakd_vio.yaml (640x400 @ 30 Hz). quat="1 0 0 0"
           is an approximation, not a measured optical-frame offset. MuJoCo's camera convention
           (-Z forward, +Y up) differs from ROS's optical convention - not corrected here. -->
      <camera name="oak_rgb" fovy="55" resolution="640 400" pos="0 0 0" quat="1 0 0 0"/>
    </body>
  </body>
</mujoco>
