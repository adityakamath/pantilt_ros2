<!--
  Variant-independent MJCF content for the PT100/PT101 pan-tilt: compiler options, shared
  meshes/materials, default classes, actuators. Mirrors pantilt.common.xacro/control.xacro/
  module.xacro. Mesh paths are $(find pt_description)-absolute, not meshdir-relative -
  MuJoCo resolves meshdir against the top-level model file's directory (a launch-time temp
  file, not this one), so a relative path would silently break. Only ever spliced in via
  pantilt.mjcf.xacro's xacro:include, never loaded directly.
-->
<mujoco model="pantilt_shared" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <compiler angle="radian"/>
  <!-- implicitfast solves actuator damping implicitly - MuJoCo's own docs call it "a strict
       improvement" over the default Euler for actuator-driven models like this one, at
       equivalent cost. -->
  <option integrator="implicitfast"/>

  <asset>
    <material name="light_grey" rgba="0.8 0.8 0.8 1.0"/>
    <material name="charcoal" rgba="0.15 0.15 0.15 1.0"/>
    <material name="transparent" rgba="1 0 0 0.3"/>

    <!-- Shared across pt100/pt101 - only pantilt_base_link's and shoulder_link's own body
         meshes differ between variants (declared in pantilt.mjcf.xacro). -->
    <mesh name="pan_motor" file="$(find pt_description)/meshes/pan_motor.stl"/>
    <mesh name="tilt_motor" file="$(find pt_description)/meshes/tilt_motor.stl"/>
    <mesh name="tilt_joint_oakd_s2" file="$(find pt_description)/meshes/tilt_joint_oakd_s2.stl"/>
    <mesh name="oakd_s2" file="$(find pt_description)/meshes/oakd_s2.stl"/>
  </asset>

  <default>
    <default class="pantilt">
      <!-- STS3215 servo (12V variant - see pantilt.control.xacro's matching comment) -->
      <joint frictionloss="0.1" armature="0.1"/>
      <!-- forcerange = +-max_torque_nm (2.942 N*m, 30 kgf*cm stall @ 12V).
           dampratio=1.5, not the nominally-"critical" 1: at this forcerange, a full-range
           step still saturates the actuator during the initial acceleration phase, and
           recovering from that saturation needs extra damping margin to land without
           overshoot - verified empirically (0.0% overshoot at dampratio=1.5 vs ~1.6-1.75%
           at dampratio=1, stepping both joints through their full ±90° range). -->
      <position kp="50" dampratio="1.5" forcerange="-2.942 2.942"/>
      <default class="pan">
        <joint axis="0 0 1" range="-1.5708 1.5708"/>
      </default>
      <default class="tilt">
        <joint axis="0 0 -1" range="-1.5708 1.5708"/>
      </default>
      <default class="visual">
        <geom type="mesh" contype="0" conaffinity="0" density="0" group="2"/>
      </default>
      <default class="collision">
        <geom type="mesh" group="3" material="transparent"/>
      </default>
    </default>
  </default>

  <actuator>
    <position class="pan" name="shoulder_pan_joint" joint="shoulder_pan_joint" inheritrange="1"/>
    <position class="tilt" name="tilt_joint" joint="tilt_joint" inheritrange="1"/>
  </actuator>

  <!-- Adjacent bodies' collision meshes overlap slightly at the joint (real geometry) -
       without this, MuJoCo applies a large corrective force from step 0. -->

  <contact>
    <exclude body1="pantilt_base_link" body2="shoulder_link"/>
    <exclude body1="shoulder_link" body2="tilt_link"/>
  </contact>
</mujoco>
