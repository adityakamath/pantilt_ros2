<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>pt_bringup</name>
  <version>0.1.0</version>
  <description>Bringup launch files and camera configuration for the Pan Tilt 100 with its OAK-D S2</description>
  <author email="adityakamath@live.com">Aditya Kamath</author>
  <maintainer email="adityakamath@live.com">Aditya Kamath (Kamath Robotics)</maintainer>
  <license>Apache-2.0</license>

  <url type="website">https://github.com/adityakamath/pantilt_ros2</url>
  <url type="repository">https://github.com/adityakamath/pantilt_ros2</url>
  <url type="bugtracker">https://github.com/adityakamath/pantilt_ros2/issues</url>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <!-- PCL compressor node -->
  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>
  <depend>sensor_msgs</depend>
  <depend>point_cloud_interfaces</depend>
  <depend>cloudini_lib</depend>
  <depend>cloudini_ros</depend>

  <!-- Launch files -->
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>pt_control</exec_depend>
  <exec_depend>depthai_ros_driver</exec_depend>
  <exec_depend>depthimage_to_laserscan</exec_depend>
  <exec_depend>octomap_server</exec_depend>

  <test_depend>ament_cmake_pytest</test_depend>
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
